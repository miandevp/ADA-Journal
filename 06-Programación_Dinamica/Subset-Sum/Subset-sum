    for (int i = 1; i <= n; i++) {
        for (int w = 1; w <= W; w++) {

            // No tomar A[i-1]
            dp[i][w] = dp[i - 1][w];

            // Tomar A[i-1]
            if (A[i - 1] <= w) {
                dp[i][w] = max(
                    dp[i][w],
                    A[i - 1] + dp[i - 1][w - A[i - 1]]
                );
            }
        }
    }

    return dp[n][W];


